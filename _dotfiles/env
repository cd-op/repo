#### custom PS1
export PS1='`ash_ps1`'

ash_ps1() {
  printf '\e[0;32m• '
  local GIT_CURRENT_COMMIT="`git rev-parse --short HEAD 2>/dev/null`"
  [ "${GIT_CURRENT_COMMIT}" != "" ] &&
    printf '%s %s (%s:%s)' \
      "`ash_ps1_now`" "`ash_ps1_pwd_git`" \
      "`ash_ps1_git_ref 2>/dev/null`" "${GIT_CURRENT_COMMIT}" ||
    printf '%s %s ' \
      "`ash_ps1_now`" "`ash_ps1_pwd`"
  printf '⯈\e[0m '
}

ash_ps1_now() {
  date +%R
}

ash_ps1_pwd_git() {
  basename `pwd`
}

ash_ps1_git_ref() {
  git symbolic-ref --short -q HEAD || git describe --tags --exact-match
}

ash_ps1_pwd() {
  [ "${HOME}" = "`pwd`" ] && printf '~' || pwd | sed 's_\([^/]\)[^/]*/_\1/_g'
}
#### end (custom PS1)

